@click.option('-n', '--namespace', default=None, help='ASIC namespace name or all.')
@click.option('-j', '--json', 'json_output', is_flag=True, help='Preserve raw DB keys and values.')
def port_info(ports, all_ports, namespace, json_output):
    """Reserve the CPO port info view."""
    if ports and all_ports:
        raise click.UsageError("--port and --all are mutually exclusive.")
    cpo = CPOShow(namespace)
    cpo.get_port("info", ports=ports or None)
    cpo.display(json_output=json_output)


