@click.option('-n', '--namespace', default=None, help='ASIC namespace name or all.')
@click.option('-j', '--json', 'json_output', is_flag=True, help='Preserve raw DB keys and values.')
def oe_flag(oe_index, bank, history, show_suppressed, namespace, json_output):
    """Show published flags and optional change history."""
    cpo = CPOShow(namespace)
    cpo.get_resource("oe", "flag", selector=oe_index, bank=bank, history=history)
    cpo.display(json_output=json_output, show_suppressed=show_suppressed)


