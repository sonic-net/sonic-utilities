@cli.group(hidden=True)
def port():
    """Internal CPO port views reserved for transceiver command dispatch."""
    pass


@port.command('eeprom')
@click.option('-p', '--port', 'ports', multiple=True, help='Repeat for a batch of canonical ports.')
@click.option('--all', 'all_ports', is_flag=True, help='Select all CPO ports.')
@click.option('-d', '--dom', 'dump_dom', is_flag=True, help='Also show OE and ELS DOM sections.')
@click.option('-n', '--namespace', default=None, help='ASIC namespace name or all.')
@click.option('-j', '--json', 'json_output', is_flag=True, help='Preserve raw DB keys and values.')
def port_eeprom(ports, all_ports, dump_dom, namespace, json_output):
    """Reserve the CPO port eeprom view."""
    if ports and all_ports:
        raise click.UsageError("--port and --all are mutually exclusive.")
    cpo = CPOShow(namespace)
    cpo.get_port("eeprom", ports=ports or None, dump_dom=dump_dom)
    cpo.display(json_output=json_output)


