{
    "README": [
        "Validate_commands provides, module & method name as ",
        "    <module name>.<method name>",
        "NOTE: module name could have '.'",
        " ",
        "The last element separated by  '.' is considered as ",
        "method name",
        "",
        "e.g. 'show.acl.test_acl'",
        "",
        "Here we load 'show.acl' and call 'test_acl' method on it.",
        "",
        "called as:",
        "    <module>.<method>>(<config before change>, ",
        "        <config after change>, <affected keys>)",
        "    config is in JSON format as in config_db.json",
        "    affected_keys in same format, but w/o value",
        "    { 'ACL_TABLE': { 'SNMP_ACL': {} ... }, ...}",
        "    The affected keys has 'added', 'updated' & 'deleted'",
        "",
        "Multiple validate commands may be provided.",
        "",
        "Note: The commands may be called in any order",
        "",
        "A table may also list 'restart_on_change' rules, each as",
        "    { 'units': [ <systemd unit>, ... ], 'fields': [ <field>, ... ],",
        "      'modified_only': true, 'reset_failed': [ <unit>, ... ],",
        "      'host_only': true, 'per_asic': true,",
        "      'defaults': { <field>: <value>, ... } }",
        "Only 'units' is required. Rules are matched against each change",
        "of a patch as it is applied. After the last change (or after one",
        "fails), each unit of a matched rule is restarted once, after",
        "'systemctl reset-failed' of the unit and of the 'reset_failed' units.",
        "swss restarts first, as restarting it also restarts its dependents.",
        "Without 'fields' any difference in the table matches. With it,",
        "the rule matches when one of those fields differs in some key of",
        "the table; a missing, empty-string or empty-list value counts as",
        "unset, and an unset field with a 'defaults' entry takes that value.",
        "With 'modified_only', a field only counts when it is set both",
        "before and after.",
        "Rules apply in every scope whose patch changes the table, unless",
        "'host_only' limits them to the host scope. With 'per_asic', the",
        "units run one instance per ASIC: an ASIC scope restarts",
        "<unit>@<asic id> (and <reset_failed unit>@<asic id>), and the host",
        "scope of a multi-ASIC device restarts nothing. A unit whose FEATURE",
        "state is disabled or always_disabled is skipped.",
        ""
    ],
    "tables": {
        "": {
            "services_to_validate": [ "system_health" ]
        },
        "PORT": {
            "restart_on_change": [ { "fields": [ "speed" ], "modified_only": true, "units": [ "telemetry" ] } ]
        },
        "SYSLOG_SERVER": {
            "restart_on_change": [ { "units": [ "rsyslog-config" ], "reset_failed": [ "rsyslog" ] } ]
        },
        "DHCP_RELAY": {
            "restart_on_change": [ { "units": [ "dhcp_relay" ] } ]
        },
        "DHCP_SERVER": {
            "restart_on_change": [ { "units": [ "dhcp_relay" ] } ]
        },
        "VLAN": {
            "restart_on_change": [ { "fields": [ "dhcp_servers" ], "units": [ "dhcp_relay" ] } ]
        },
        "ACL_RULE": {
            "services_to_validate": [ "caclmgrd-service" ]
        },
        "NTP_SERVER": {
            "restart_on_change": [ { "units": [ "chrony" ] } ]
        },
        "VLAN_INTERFACE": {
            "services_to_validate": [ "vlanintf-service" ]
        },
        "GNMI": {
            "restart_on_change": [ { "fields": [ "vrf" ], "units": [ "gnmi" ] } ]
        },
        "TELEMETRY": {
            "restart_on_change": [ { "fields": [ "vrf" ], "units": [ "telemetry" ] } ]
        },
        "DEVICE_METADATA": {
            "restart_on_change": [
                {
                    "fields": [ "bgp_asn", "bgp_router_id", "bgp_adv_lo_prefix_as_128", "default_bgp_status",
                                "deployment_id", "docker_routing_config_mode", "frr_mgmt_framework_config",
                                "nexthop_group", "zebra_nexthop" ],
                    "defaults": { "bgp_adv_lo_prefix_as_128": "false", "default_bgp_status": "up",
                                  "docker_routing_config_mode": "separated", "frr_mgmt_framework_config": "false",
                                  "nexthop_group": "disabled", "zebra_nexthop": "enabled" },
                    "units": [ "bgp" ],
                    "per_asic": true
                },
                {
                    "fields": [ "mac", "synchronous_mode", "buffer_model", "switch_id", "max_cores",
                                "ring_thread_enabled", "orch_northbond_dash_zmq_enabled", "suppress-fib-pending" ],
                    "defaults": { "synchronous_mode": "enable", "buffer_model": "traditional",
                                  "ring_thread_enabled": "false", "orch_northbond_dash_zmq_enabled": "true",
                                  "suppress-fib-pending": "disabled" },
                    "units": [ "swss" ],
                    "reset_failed": [ "syncd" ],
                    "per_asic": true
                },
                {
                    "fields": [ "deployment_id", "has_sonic_dhcpv4_relay" ],
                    "defaults": { "has_sonic_dhcpv4_relay": "False" },
                    "units": [ "dhcp_relay" ],
                    "host_only": true
                }
            ]
        },
        "SNMP": {
            "restart_on_change": [ { "units": [ "snmp" ], "host_only": true } ]
        },
        "SNMP_COMMUNITY": {
            "restart_on_change": [ { "units": [ "snmp" ], "host_only": true } ]
        },
        "SNMP_USER": {
            "restart_on_change": [ { "units": [ "snmp" ], "host_only": true } ]
        },
        "SNMP_AGENT_ADDRESS_CONFIG": {
            "restart_on_change": [ { "units": [ "snmp" ], "host_only": true } ]
        },
        "SNMP_TRAP_CONFIG": {
            "restart_on_change": [ { "units": [ "snmp" ], "host_only": true } ]
        }
    },
    "services": {
        "system_health": { 
            "validate_commands": [ ]
        },
        "caclmgrd-service": {
            "validate_commands": [ "generic_config_updater.services_validator.caclmgrd_validator" ]
        },
        "vlanintf-service": {
            "validate_commands": [ "generic_config_updater.services_validator.vlanintf_validator" ]
        }
    }
}

